{
  "name": "wizarding-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bench:gestures": "vitest run --config vitest.bench.config.ts",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p src/perception/worker",
    "format": "prettier --write .",
    "measure:fps": "node scripts/measure-fps.mjs",
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "fetch:model": "node scripts/fetch-model.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1"
  }
}
